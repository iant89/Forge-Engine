{
  "name": "forge-engine-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Forge \u2014 a browser-native WebGPU 3D game & real-time simulation engine",
  "type": "module",
  "workspaces": [
    "engine",
    "editor",
    "packages/selrun"
  ],
  "scripts": {
    "setup": "bash scripts/setup-deps.sh",
    "setup:check": "bash scripts/setup-deps.sh --check",
    "build": "tsc -b engine editor --pretty false",
    "typecheck": "tsc -b engine editor --pretty false && tsc -p examples/tsconfig.json --noEmit --pretty false && tsc -p tests/tsconfig.json --noEmit --pretty false && tsc -p benchmarks/tsconfig.json --noEmit --pretty false",
    "test": "selrun run --all",
    "test:run": "selrun run --all",
    "test:serial": "selrun serial",
    "test:affected": "selrun affected",
    "test:affected:print": "selrun affected --print",
    "test:all": "selrun run --all",
    "test:check": "selrun check",
    "test:audit": "selrun audit",
    "pr:checks": "node tools/pr-checks.mjs",
    "gltf:strip-skin-sets": "node tools/gltf-strip-extra-skin-sets.mjs",
    "gltf:fix-handedness": "node tools/gltf-fix-handedness.mjs",
    "bench": "node benchmarks/run.mjs",
    "demo": "vite --config examples/vite.config.ts --host 0.0.0.0",
    "demo:mars": "vite --config examples/vite.config.ts --host 0.0.0.0 --open \"/?scene=terrain\"",
    "demo:showcase": "vite --config examples/vite.config.ts --host 0.0.0.0 --open \"/?scene=mars-showcase\"",
    "demo:amazon": "vite --config examples/vite.config.ts --host 0.0.0.0 --open \"/?scene=amazon-river\"",
    "lint:arch": "node tools/lint-arch.mjs",
    "api:check": "node tools/api-audit.mjs",
    "api:update": "node tools/api-audit.mjs --write",
    "docs:check": "tsx tools/docs-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:wgsl",
    "check:wgsl": "node tools/wgsl-check.mjs",
    "check:mars-port": "tsx tools/mars-port-check.mjs",
    "check:replay-engines": "node tools/replay-engines.mjs",
    "check:browser": "node tools/browser-check.mjs",
    "check:browser:renderer": "node tools/browser-check.mjs --section=renderer",
    "check:browser:terrain": "node tools/browser-check.mjs --section=terrain",
    "check:browser:vehicle-particles": "node tools/browser-check.mjs --section=vehicle-particles",
    "check:browser:animation": "node tools/browser-check.mjs --section=animation",
    "check:browser:environment": "node tools/browser-check.mjs --section=environment",
    "check:browser:mars": "node tools/browser-check.mjs --section=mars",
    "check:browser:workers": "node tools/browser-check.mjs --workers-only",
    "check:browser:terrain-layers": "node tools/browser-check.mjs --terrain-layers",
    "check:browser:ui": "node tools/browser-ui-check.mjs",
    "check:browser:mars-workers": "node tools/browser-check.mjs --mars-workers",
    "check:browser:mars-generator": "node tools/browser-check.mjs --mars-generator",
    "check:browser:mars-interactive": "node tools/browser-check.mjs --mars-interactive",
    "check:browser:skinning": "node tools/browser-check.mjs --skinning",
    "check:browser:gltf-skin": "node tools/browser-check.mjs --gltf-skin",
    "check:browser:mechanical": "node tools/browser-check.mjs --mechanical",
    "check:browser:rescue": "node tools/browser-check.mjs --rescue",
    "check:browser:amazon": "node tools/browser-check.mjs --amazon",
    "demo:build": "vite build --config examples/vite.config.ts",
    "bench:build": "tsc -p benchmarks/tsconfig.json"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.10.2",
    "@webgpu/types": "^0.1.52",
    "draco3dgltf": "^1.5.7",
    "playwright-core": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
