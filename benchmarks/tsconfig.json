{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../.tsbuild/benchmarks",
    "tsBuildInfoFile": "../.tsbuild/benchmarks.tsbuildinfo",
    "types": [
      "@webgpu/types",
      "node"
    ],
    "composite": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../engine"
    }
  ]
}