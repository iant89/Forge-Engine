{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": [
      "@webgpu/types",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@forge/engine": [
        "../engine/src/index.ts"
      ],
      "@forge/engine/*": [
        "../engine/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ]
}